# ===== MIS backend environment =====
# Copy to .env and fill in. NEVER commit the real .env.

# --- MIS's own Postgres (read/write) ---
# Async driver form: postgresql+asyncpg://user:pass@host:5432/dbname
MIS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mis

# --- CRM read-only connections (mis_readonly role) ---
# These are plain asyncpg DSNs (no +asyncpg suffix) used by the sync worker.
# postgresql://mis_readonly:<pw>@<host>:5432/postgres
FMC_DB_URL=postgresql://mis_readonly:CHANGE_ME@fmc-host:5432/postgres
AV_DB_URL=postgresql://mis_readonly:CHANGE_ME@av-host:5432/postgres

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720          # 12h

# --- Sync ---
SYNC_INTERVAL_MINUTES=45
SYNC_ENABLED=true                        # set false to disable the scheduler (e.g. in tests)
DUPLICATE_WINDOW_DAYS=30

# --- CORS (JSON array) ---
CORS_ORIGINS=["http://localhost:3000"]

# --- App ---
ENV=development                          # development | production
LOG_LEVEL=INFO
